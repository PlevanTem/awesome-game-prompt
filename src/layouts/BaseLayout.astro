---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Awesome Game Prompts — AI Game Art Workflows',
  description = 'AI game art workflows, tested prompts, and visual references for character design, concept art, UI, VFX, and 3D production.',
  image = '/generated/prompt-assets/recvs8iwpywn1f-0.png',
  type = 'website',
  jsonLd,
} = Astro.props;
const configuredBase = process.env.BASE_PATH || '/';
const base = configuredBase.endsWith('/') ? configuredBase : `${configuredBase}/`;
const site = Astro.site ?? new URL('https://plevantem.github.io');
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalUrl = new URL(canonicalPath, site).toString();
const socialImageUrl = image.startsWith('http')
  ? image
  : new URL(`${base}${image.replace(/^\//, '')}`, site).toString();
const serializedJsonLd = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`${base}game-prompt-mark.svg`} type="image/svg+xml" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href={`${base}sitemap.xml`} />
    <meta property="og:site_name" content="Awesome Game Prompts" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content="Awesome Game Prompts workflow example" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <title>{title}</title>
    {serializedJsonLd && <script type="application/ld+json" set:html={serializedJsonLd} />}
  </head>
  <body>
    <slot />
    <script>
      const preferenceKey = 'awesome-game-prompts-language';
      const applyLanguage = (language) => {
        const english = language === 'en';
        document.documentElement.lang = english ? 'en' : 'zh-CN';
        document.querySelectorAll('[data-i18n-zh]').forEach((element) => {
          const value = element.dataset[english ? 'i18nEn' : 'i18nZh'];
          if (value) element.textContent = value;
        });
        document.querySelectorAll('[data-i18n-aria-zh]').forEach((element) => {
          const value = element.dataset[english ? 'i18nAriaEn' : 'i18nAriaZh'];
          if (value) element.setAttribute('aria-label', value);
        });
        document.querySelectorAll('[data-language-toggle]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.language === language));
        });
      };
      try { applyLanguage(localStorage.getItem(preferenceKey) === 'en' ? 'en' : 'zh'); } catch { applyLanguage('zh'); }
      document.querySelectorAll('[data-language-toggle]').forEach((button) => button.addEventListener('click', () => {
        const language = button.dataset.language === 'en' ? 'en' : 'zh';
        try { localStorage.setItem(preferenceKey, language); } catch {}
        applyLanguage(language);
      }));
    </script>
  </body>
</html>
