---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = 'Prompt Forge' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="A personal archive of game-art prompts maintained in Feishu Base and exported as a static site."
    />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
