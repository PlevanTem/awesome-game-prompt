---
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
const repositoryUrl = process.env.GITHUB_REPOSITORY_URL || 'https://github.com/PlevanTem/awesome-game-prompt';
const profileUrl = 'https://plevantem.github.io/bufan.ux/';
const description = 'Awesome Game Prompts 是一个 AI 游戏美术工作流与实测提示词库，覆盖角色设计、概念美术、UI、特效与 3D 交接。';
---
<BaseLayout title="关于 Awesome Game Prompts" description={description}>
  <SiteHeader />
  <main class="archive-index">
    <div class="archive-index__heading"><p class="archive-index__eyebrow">ABOUT</p><h1>Awesome Game Prompts</h1></div>
    <section class="archive-index__empty" aria-label="关于 Awesome Game Prompts">
      <p data-i18n-zh="一个面向实际制作环节的 AI 游戏美术工作流库。每条提示词保留原始内容与样图；组合工作流进一步给出输入、输出、验收门槛和交接清单。" data-i18n-en="A public AI game-art workflow library built around real production stages. Every prompt keeps its original text and example output; composed workflows add inputs, outputs, acceptance gates, and handoff manifests.">一个面向实际制作环节的 AI 游戏美术工作流库。每条提示词保留原始内容与样图；组合工作流进一步给出输入、输出、验收门槛和交接清单。</p>
      <p data-i18n-zh="我是布凡，专注用 AI 把游戏美术从单张出图推进到可验证、可交付的生产工作流。" data-i18n-en="I'm Bufan, focused on turning AI game art from one-off images into reviewable, deliverable production workflows.">我是布凡，专注用 AI 把游戏美术从单张出图推进到可验证、可交付的生产工作流。</p>
      <p><strong data-i18n-zh="交流合作" data-i18n-en="CONTACT">交流合作</strong>：微信 <code>lelouchdbf</code> · <a href={profileUrl}>个人主页 ↗</a> · <a href={repositoryUrl}>GitHub ↗</a></p>
    </section>
  </main>
</BaseLayout>
